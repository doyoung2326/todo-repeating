{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "http://10.0.2.2:3001/api"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://todo-repeating-production.up.railway.app/api"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://todo-repeating-production.up.railway.app/api"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "APP_STORE_CONNECT_앱_ID를_여기에"
      },
      "android": {
        "track": "internal"
      }
    }
  }
}
